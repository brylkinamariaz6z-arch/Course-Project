6. КОРРЕЛЯЦИОННЫЙ АНАЛИЗ
print("\n" + "=" * 60)
print("ЭТАП 6. КОРРЕЛЯЦИОННЫЙ АНАЛИЗ")
print("=" * 60)

corr_matrix = df.corr(method='pearson')

plt.figure(figsize=(14, 12))
mask = np.triu(np.ones_like(corr_matrix, dtype=bool), k=1)
sns.heatmap(corr_matrix, mask=mask, annot=True, fmt='.2f', cmap='RdBu_r',
            center=0, square=True, linewidths=0.5, cbar_kws={'shrink': 0.8})
plt.title('Матрица корреляций Пирсона между каналами', fontsize=14)
plt.xticks(rotation=45, ha='right')
plt.yticks(rotation=0)
plt.tight_layout()
plt.savefig('fig_correlation_heatmap.png', dpi=150)
plt.show()
print("Тепловая карта корреляций сохранена как 'fig_correlation_heatmap.png'")

corr_with_target = corr_matrix['CO(GT)'].sort_values(ascending=False)
print("\nТаблица 4. Корреляции с целевой переменной CO(GT):")
print(corr_with_target.round(3))

upper_tri = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
high_corr = upper_tri.stack().reset_index()
high_corr.columns = ['Канал1', 'Канал2', 'Корреляция']
high_corr = high_corr[high_corr['Корреляция'].abs() > 0.95].sort_values('Корреляция', ascending=False)
print("\nТаблица 5. Пары каналов с корреляцией > 0.95 (мультиколлинеарность):")
print(high_corr.round(3))

7. ПОИСК И АНАЛИЗ ШУМОВ
print("\n" + "=" * 60)
print("ЭТАП 7. ПОИСК И АНАЛИЗ ШУМОВ")
print("=" * 60)

ts = df['CO(GT)'].dropna()

decomp = seasonal_decompose(ts, model='additive', period=24)
trend = decomp.trend
seasonal = decomp.seasonal
residual = decomp.resid

fig, axes = plt.subplots(4, 1, figsize=(14, 12), sharex=True)
axes[0].plot(ts, label='Исходный ряд', color='blue', lw=0.8)
axes[0].set_ylabel('CO(GT) [mg/m³]')
axes[0].set_title('Исходный временной ряд')
axes[0].legend()
axes[0].grid(True, alpha=0.3)

axes[1].plot(trend, label='Тренд', color='green', lw=0.8)
axes[1].set_ylabel('Тренд')
axes[1].set_title('Трендовая компонента')
axes[1].legend()
axes[1].grid(True, alpha=0.3)

axes[2].plot(seasonal, label='Сезонность', color='orange', lw=0.8)
axes[2].set_ylabel('Сезонность')
axes[2].set_title('Сезонная компонента (период=24ч)')
axes[2].legend()
axes[2].grid(True, alpha=0.3)

axes[3].plot(residual, label='Шум (остатки)', color='red', lw=0.5)
axes[3].set_ylabel('Шум')
axes[3].set_title('Остаточная компонента (шум)')
axes[3].legend()
axes[3].grid(True, alpha=0.3)

plt.xlabel('Дата и время')
plt.tight_layout()
plt.savefig('fig_decomposition.png', dpi=150)
plt.show()
print("График декомпозиции сохранён как 'fig_decomposition.png'")

signal = trend + seasonal
signal_var = signal.var()
noise_var = residual.var()
SNR = 10 * np.log10(signal_var / noise_var)

print(f"\nДисперсия сигнала (тренд+сезонность): {signal_var:.4f}")
print(f"Дисперсия шума (остатки): {noise_var:.4f}")
print(f"Отношение сигнал/шум (SNR): {SNR:.2f} дБ")

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))
resid_clean = residual.dropna()

ax1.hist(resid_clean, bins=50, edgecolor='black', alpha=0.7, color='red')
ax1.set_title('Распределение остатков (шума)')
ax1.set_xlabel('Значение шума')
ax1.set_ylabel('Частота')
ax1.grid(True, alpha=0.3)

stats.probplot(resid_clean, dist='norm', plot=ax2)
ax2.set_title('Q-Q график для проверки нормальности')
ax2.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('fig_noise_distribution.png', dpi=150)
plt.show()
print("График распределения шума сохранён как 'fig_noise_distribution.png'")

