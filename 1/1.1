3. СТАТИСТИЧЕСКИЙ АНАЛИЗ 
print("\n" + "=" * 60)
print("ЭТАП 3. СТАТИСТИЧЕСКИЙ АНАЛИЗ")
print("=" * 60)

stats_df = df.describe().T
stats_df['median'] = df.median()
stats_df['Q1'] = df.quantile(0.25)
stats_df['Q3'] = df.quantile(0.75)
stats_df['cv'] = stats_df['std'] / stats_df['mean']  # коэффициент вариации

print("Таблица 1. Статистические характеристики каналов:")
print(stats_df[['mean', 'std', 'min', 'Q1', 'median', 'Q3', 'max', 'cv']].round(2))

time_diffs = df.index.to_series().diff().dt.total_seconds().dropna()
unique_diffs = time_diffs.unique()
print(f"\nУникальные интервалы между измерениями (сек): {unique_diffs}")
print(f"Доля интервалов, равных 3600 сек: {(time_diffs == 3600).mean()*100:.2f}%")

4. АНАЛИЗ ПРОПУСКОВ И ВЫБРОСОВ 
print("\n" + "=" * 60)
print("ЭТАП 4. АНАЛИЗ ПРОПУСКОВ И ВЫБРОСОВ")
print("=" * 60)

missing_pct = (df.isna().sum() / len(df)) * 100
missing_pct_sorted = missing_pct.sort_values(ascending=False)
print("Таблица 2. Доля пропущенных значений по каналам (%):")
print(missing_pct_sorted.round(2))

def count_outliers_3sigma(series):
    s = series.dropna()
    if len(s) == 0:
        return 0, 0.0
    mean, std = s.mean(), s.std()
    outliers = (s < mean - 3*std) | (s > mean + 3*std)
    return outliers.sum(), (outliers.sum() / len(s)) * 100

outliers_data = []
for col in df.columns:
    n, pct = count_outliers_3sigma(df[col])
    outliers_data.append([col, n, pct])

outliers_df = pd.DataFrame(outliers_data, columns=['Канал', 'Кол-во выбросов', 'Доля (%)'])
outliers_df = outliers_df.sort_values('Доля (%)', ascending=False)
print("\nТаблица 3. Количество и доля выбросов по правилу 3σ:")
print(outliers_df.round(2))

fig, axes = plt.subplots(4, 4, figsize=(16, 12))
axes = axes.flatten()
for i, col in enumerate(df.columns):
    df.boxplot(column=col, ax=axes[i])
    axes[i].set_title(col, fontsize=10)
    axes[i].grid(True, alpha=0.3)
for i in range(len(df.columns), len(axes)):
    axes[i].set_visible(False)
plt.suptitle("Диаграммы размаха для всех каналов")
plt.tight_layout()
plt.savefig('fig_boxplots.png', dpi=150)
plt.show()
print("График boxplot сохранён как 'fig_boxplots.png'")

